# Vendor packages -- not ours to version, and huge. Re-download/re-extract
# as needed. Everything vendor-supplied now lives under at32f435_lib/, and
# every Makefile under mdl/tests/hil/ resolves VENDOR to
#   at32f435_lib/AT32F435_437_Firmware_Library_V2.2.6/
# so that directory must exist (extracted from the zip beside it) before
# anything builds.
/at32f435_lib/

# Build outputs
build/
*.o
*.d
*.elf
*.bin
*.map
*.mdl

# Ozone per-user window/session state -- regenerated on every open, and
# specific to one machine. The project file itself (mdl/mdl.jdebug) IS
# versioned; this sidecar is not.
*.jdebug.user

# Python bytecode from the host-side tools
__pycache__/
*.pyc

# Claude Code local session state (locks, per-machine settings)
.claude/
